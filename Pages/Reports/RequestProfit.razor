@page "/reports/requestprofit"
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<h3>Прибыль от реализации заявок</h3>

<div class="row mb-3">
    <div class="col-md-2">
        <label>Наценка (%)</label>
        <input type="number" step="0.1" @bind="marginPercent" class="form-control" />
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary" @onclick="LoadReport">Рассчитать</button>
    </div>
</div>

@if (reportData != null)
{
    <table class="table">
        <thead><tr><th>ID заявки</th><th>Изделие</th><th>Кол-во</th><th>Себестоимость</th><th>Цена продажи</th><th>Прибыль</th></tr></thead>
        <tbody>
            @foreach (var r in reportData)
            {
                <tr>
                    <td>@r.RequestId</td>
                    <td>@r.ProductName</td>
                    <td>@r.Quantity</td>
                    <td>@r.Cost.ToString("C")</td>
                    <td>@r.SellingPrice.ToString("C")</td>
                    <td>@r.Profit.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot><tr><th colspan="5">Итого прибыль:</th><th>@reportData.Sum(x => x.Profit).ToString("C")</th></tr></tfoot>
    </table>
}

@code {
    private class ReportItem { public int RequestId { get; set; } 
    public string ProductName { get; set; }
    public int Quantity { get; set; } 
    public decimal Cost { get; set; } 
    public decimal SellingPrice { get; set; } 
    public decimal Profit { get; set; } }
    private List<ReportItem> reportData;
    private decimal marginPercent = 25;

    private async Task LoadReport()
    {
        var query = from r in DbContext.Requests
                    join p in DbContext.Products on r.ProductId equals p.ProductId
                    join tp in DbContext.TechProcesses on p.TechProcessId equals tp.TechProcessId
                    join m in DbContext.Materials on tp.MaterialId equals m.MaterialId
                    let materialCost = tp.MaterialQuantity * m.Cost
                    let operationsCost = (from tpo in DbContext.TechProcessOperations
                                          join o in DbContext.Operations on tpo.OperationId equals o.OperationId
                                          where tpo.TechProcessId == tp.TechProcessId
                                          select o.Cost).Sum()
                    let componentsCost = (from pc in DbContext.ProductComponents
                                          join c in DbContext.Components on pc.ComponentId equals c.ComponentId
                                          where pc.ProductId == p.ProductId
                                          select pc.Quantity * c.Cost).Sum()
                    let totalCostPerUnit = materialCost + operationsCost + componentsCost
                    select new ReportItem
                    {
                        RequestId = r.RequestId,
                        ProductName = p.Name,
                        Quantity = r.Quantity,
                        Cost = totalCostPerUnit * r.Quantity,
                        SellingPrice = totalCostPerUnit * r.Quantity * (1 + marginPercent / 100),
                        Profit = totalCostPerUnit * r.Quantity * (marginPercent / 100)
                    };

        reportData = await query.ToListAsync();
    }
}