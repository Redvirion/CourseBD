@page "/productcost"
@using CourseBD.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<h3>Себестоимость всех изделий</h3>

<div class="row mb-3">
    <div class="col-md-3">
        <select @bind="sortField" class="form-select">
            <option value="Name">Наименование</option>
            <option value="Cost">Себестоимость</option>
        </select>
    </div>
    <div class="col-md-2">
        <select @bind="sortDirection" class="form-select">
            <option value="asc">По возрастанию</option>
            <option value="desc">По убыванию</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary" @onclick="LoadReport">Сформировать</button>
    </div>
</div>

@if (reportData == null)
{
    <p>Нажмите «Сформировать» для загрузки отчёта.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Изделие</th>
                <th>Себестоимость</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in reportData)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.TotalCost.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th>Итого:</th>
                <th>@reportData.Sum(x => x.TotalCost).ToString("C")</th>
            </tr>
        </tfoot>
    </table>
}

@code {
    private class ReportItem
    {
        public string ProductName { get; set; }
        public decimal TotalCost { get; set; }
    }

    private List<ReportItem> reportData;
    private string sortField = "Name";
    private string sortDirection = "asc";

    private async Task LoadReport()
    {
        var query = from p in DbContext.Products
                    join pc in DbContext.ProductCompositions on p.ProductId equals pc.ProductId into comps
                    from pc in comps.DefaultIfEmpty()
                    join c in DbContext.Components on pc.ComponentId equals c.ComponentId into components
                    from c in components.DefaultIfEmpty()
                    group new { p, pc, c } by new { p.ProductId, p.Name } into g
                    select new ReportItem
                    {
                        ProductName = g.Key.Name,
                        TotalCost = g.Sum(x => x.c != null ? x.c.Cost * x.pc.Quantity : 0)
                    };

        if (sortField == "Name")
            query = sortDirection == "asc" ? query.OrderBy(x => x.ProductName) : query.OrderByDescending(x => x.ProductName);
        else
            query = sortDirection == "asc" ? query.OrderBy(x => x.TotalCost) : query.OrderByDescending(x => x.TotalCost);

        reportData = await query.ToListAsync();
    }

}