@page "/reports/profit"
@using CourseBD.Data
@using CourseBD.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<h3>Прибыль от реализации</h3>

<div class="row mb-3">
    <div class="col-md-2">
        <label>Маржа (%)</label>
        <input @bind="marginPercent" class="form-control" type="number" step="0.1" min="0" />
    </div>
    <div class="col-md-3">
        <label>Фильтр по изделию</label>
        <select @bind="filterProductId" class="form-select">
            <option value="">-- Все изделия --</option>
            @if (products != null)
            {
                @foreach (var product in products)
                {
                    <option value="@product.ProductId">@product.Name</option>
                }
            }
            else
            {
                <option value="" disabled>Загрузка...</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary mt-4" @onclick="LoadReport">Рассчитать</button>
    </div>
</div>

@if (reportData != null)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Изделие</th>
                <th>Себестоимость</th>
                <th>Цена продажи</th>
                <th>Прибыль</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in reportData)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Cost.ToString("C")</td>
                    <td>@item.SellingPrice.ToString("C")</td>
                    <td>@item.Profit.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th>Итого:</th>
                <th>@reportData.Sum(x => x.Cost).ToString("C")</th>
                <th>@reportData.Sum(x => x.SellingPrice).ToString("C")</th>
                <th>@reportData.Sum(x => x.Profit).ToString("C")</th>
            </tr>
        </tfoot>
    </table>
}

@code {
    private class ReportItem
    {
        public string ProductName { get; set; }
        public decimal Cost { get; set; }
        public decimal SellingPrice { get; set; }
        public decimal Profit { get; set; }
    }

    private List<Product> products = new();
    private int? filterProductId;
    private decimal marginPercent = 20;
    private List<ReportItem> reportData;
       
    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await DbContext.Products.ToListAsync() ?? new List<Product>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки изделий: {ex.Message}");
            products = new List<Product>();
        }
    }

    private async Task LoadReport()
    {
        var costQuery = from p in DbContext.Products
                        join pc in DbContext.ProductCompositions on p.ProductId equals pc.ProductId into comps
                        from pc in comps.DefaultIfEmpty()
                        join c in DbContext.Components on pc.ComponentId equals c.ComponentId into components
                        from c in components.DefaultIfEmpty()
                        group new { p, pc, c } by new { p.ProductId, p.Name } into g
                        select new
                        {
                            ProductId = g.Key.ProductId,
                            ProductName = g.Key.Name,
                            Cost = g.Sum(x => x.c != null ? x.c.Cost * x.pc.Quantity : 0)
                        };

        if (filterProductId.HasValue)
            costQuery = costQuery.Where(x => x.ProductId == filterProductId.Value);

        var costs = await costQuery.ToListAsync();

        reportData = costs.Select(c => new ReportItem
        {
            ProductName = c.ProductName,
            Cost = c.Cost,
            SellingPrice = c.Cost * (1 + marginPercent / 100),
            Profit = c.Cost * marginPercent / 100
        }).ToList();
    }

}