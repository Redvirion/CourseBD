@page "/reports/productfullcomposition"
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<h3>Полный состав изделия</h3>

<div class="row mb-3">
    <div class="col-md-3">
        <label>Изделие</label>
        <select @bind="selectedProductId" class="form-select">
            <option value="0">-- Все --</option>
            @foreach (var p in products)
            {
                <option value="@p.ProductId">@p.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary" @onclick="LoadReport">Показать</button>
    </div>
</div>

@if (reportData != null)
{
    @foreach (var group in reportData.GroupBy(x => x.ProductName))
    {
        <h4>@group.Key</h4>
        <table class="table">
            <thead><tr><th>Комплектующее</th><th>Количество</th><th>Стоимость ед.</th><th>Сумма</th></tr></thead>
            <tbody>
                @foreach (var item in group)
                {
                    <tr>
                        <td>@item.ComponentName</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitCost.ToString("C")</td>
                        <td>@((item.UnitCost * item.Quantity).ToString("C"))</td>
                    </tr>
                }
            </tbody>
            <tfoot><tr><th colspan="3">Итого по изделию:</th><th>@group.Sum(x => x.UnitCost * x.Quantity).ToString("C")</th></tr></tfoot>
        </table>
    }
}

@code {
    private class ReportItem { public string ProductName { get; set; } public string ComponentName { get; set; } public int Quantity { get; set; } public decimal UnitCost { get; set; } }
    private List<Product> products = new();
    private int selectedProductId;
    private List<ReportItem> reportData;

    protected override async Task OnInitializedAsync() => products = await DbContext.Products.ToListAsync();

    private async Task LoadReport()
    {
        var query = from pc in DbContext.ProductComponents
                    join p in DbContext.Products on pc.ProductId equals p.ProductId
                    join c in DbContext.Components on pc.ComponentId equals c.ComponentId
                    where selectedProductId == 0 || pc.ProductId == selectedProductId
                    select new ReportItem
                    {
                        ProductName = p.Name,
                        ComponentName = c.Name,
                        Quantity = pc.Quantity,
                        UnitCost = c.Cost
                    };
        reportData = await query.ToListAsync();
    }
}