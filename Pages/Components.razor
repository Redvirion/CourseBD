@page "/components"
@using CourseBD.Models
@using CourseBD.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@implements IDisposable

<h3>Справочник комплектующих</h3>

<div class="row mb-3">
    <div class="col-md-2">
        <input @bind="searchId" @bind:event="oninput" class="form-control" placeholder="Обозначение" />
    </div>
    <div class="col-md-3">
        <input @bind="searchName" @bind:event="oninput" class="form-control" placeholder="Наименование" />
    </div>
    <div class="col-md-2">
        <select @bind="sortField" class="form-select">
            <option value="ComponentId">Обозначение</option>
            <option value="Name">Наименование</option>
            <option value="Cost">Стоимость</option>
        </select>
    </div>
    <div class="col-md-2">
        <select @bind="sortDirection" class="form-select">
            <option value="asc">По возрастанию</option>
            <option value="desc">По убыванию</option>
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary" @onclick="ApplyFilters">Применить</button>
        <button class="btn btn-secondary" @onclick="ResetFilters">Сброс</button>
    </div>
</div>

<div class="mb-2">
    <button class="btn btn-success" @onclick="OpenAddModal">Добавить комплектующее</button>
</div>

@if (components == null)
{
    <p>Загрузка...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Обозначение</th>
                <th>Наименование</th>
                <th>Стоимость</th>
                <th>Техпроцесс (ссылка)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var comp in components)
            {
                <tr>
                    <td>@comp.ComponentId</td>
                    <td>@comp.Name</td>
                    <td>@comp.Cost.ToString("C")</td>
                    <td>@comp.TechProcessRef</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => OpenEditModal(comp)">Изменить</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteComponent(comp.ComponentId)">Удалить</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Пагинация -->
    <nav>
        <ul class="pagination">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" @onclick="() => ChangePage(currentPage - 1)">Предыдущая</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link" @onclick="() => ChangePage(i)">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" @onclick="() => ChangePage(currentPage + 1)">Следующая</a>
            </li>
        </ul>
    </nav>
}

<!-- Модальное окно -->
<div class="modal fade @(showModal ? "show d-block" : "")" style="background: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@modalTitle</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@editModel" OnValidSubmit="@SaveComponent">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label class="form-label">Обозначение</label>
                        <InputText @bind-Value="editModel.ComponentId" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Наименование</label>
                        <InputText @bind-Value="editModel.Name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Стоимость</label>
                        <InputNumber @bind-Value="editModel.Cost" class="form-control" step="0.01" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Техпроцесс (обозначение родительского компонента)</label>
                        <InputSelect @bind-Value="editModel.TechProcessRef" class="form-select">
                            <option value="">-- Нет --</option>
                            @if (allComponents != null)
                            {
                                @foreach (var comp in allComponents)
                                {
                                    <option value="@comp.ComponentId">@comp.ComponentId - @comp.Name</option>
                                }
                            }
                            else
                            {
                                <option value="" disabled>Загрузка...</option>
                            }
                        </InputSelect>
                    </div>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Component> components;
    private List<Component> allComponents = new();
    private string searchId = "";
    private string searchName = "";
    private string sortField = "ComponentId";
    private string sortDirection = "asc";
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;

    private bool showModal = false;
    private string modalTitle = "Добавление комплектующего";
    private Component editModel = new Component();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllComponents();
        await LoadData();
    }

    private async Task LoadAllComponents()
    {
        try
        {
            allComponents = await DbContext.Components.ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки компонентов: {ex.Message}");
            allComponents = new List<Component>();
        }
    }

    private async Task LoadData()
    {
        var query = DbContext.Components.AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchId))
            query = query.Where(c => c.ComponentId.Contains(searchId));
        if (!string.IsNullOrWhiteSpace(searchName))
            query = query.Where(c => c.Name.Contains(searchName));

        query = sortField switch
        {
            "ComponentId" => sortDirection == "asc" ? query.OrderBy(c => c.ComponentId) : query.OrderByDescending(c => c.ComponentId),
            "Name" => sortDirection == "asc" ? query.OrderBy(c => c.Name) : query.OrderByDescending(c => c.Name),
            "Cost" => sortDirection == "asc" ? query.OrderBy(c => c.Cost) : query.OrderByDescending(c => c.Cost),
            _ => query.OrderBy(c => c.ComponentId)
        };

        int totalCount = await query.CountAsync();
        totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);

        components = await query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadData();
    }

    private async Task ResetFilters()
    {
        searchId = "";
        searchName = "";
        sortField = "ComponentId";
        sortDirection = "asc";
        currentPage = 1;
        await LoadData();
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadData();
    }

    private void OpenAddModal()
    {
        editModel = new Component();
        modalTitle = "Добавление комплектующего";
        showModal = true;
    }

    private void OpenEditModal(Component component)
    {
        editModel = new Component
        {
            ComponentId = component.ComponentId,
            Name = component.Name,
            Cost = component.Cost,
            TechProcessRef = component.TechProcessRef
        };
        modalTitle = "Редактирование комплектующего";
        showModal = true;
    }

    private async Task SaveComponent()
    {
        var existing = await DbContext.Components.FindAsync(editModel.ComponentId);
        if (existing == null)
            DbContext.Components.Add(editModel);
        else
        {
            existing.Name = editModel.Name;
            existing.Cost = editModel.Cost;
            existing.TechProcessRef = editModel.TechProcessRef;
        }
        await DbContext.SaveChangesAsync();
        await LoadAllComponents();
        CloseModal();
        await LoadData();
    }

    private async Task DeleteComponent(string id)
    {
        var component = await DbContext.Components.FindAsync(id);
        if (component != null)
        {
            DbContext.Components.Remove(component);
            await DbContext.SaveChangesAsync();
            await LoadAllComponents();
            await LoadData();
        }
    }

    private void CloseModal() => showModal = false;

    public void Dispose() => DbContext?.Dispose();
}