@page "/materials"
@using CourseBD.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@implements IDisposable

<h5 class="mb-2">📦 Материалы</h5>

<!-- Уведомления -->
@if (!string.IsNullOrEmpty(notificationMessage))
{
    <div class="alert alert-@notificationType alert-dismissible fade show d-flex align-items-center py-1 mb-2" role="alert">
        <span class="flex-grow-1 small">@notificationMessage</span>
        <button type="button" class="btn-close btn-close-sm" @onclick="ClearNotification"></button>
    </div>
}
 
<div class="d-flex flex-nowrap gap-2 mb-2 align-items-end overflow-auto">
    <div class="input-group input-group-sm" style="min-width: 200px;">
        <span class="input-group-text">🔍</span>
        <input type="text" class="form-control form-control-sm"
               @bind-value:get="searchName"
               @bind-value:set="SetSearchName"
               @bind-value:event="oninput"
               placeholder="Наименование" />
        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSearch">✖</button>
    </div>
    <input type="number" class="form-control form-control-sm" style="width: 100px;" @bind="minCost" @bind:event="oninput" step="0.01" placeholder="Цена от" />
    <input type="number" class="form-control form-control-sm" style="width: 100px;" @bind="maxCost" @bind:event="oninput" step="0.01" placeholder="до" />
    <select class="form-select form-select-sm" style="width: auto;" @bind="pageSize" @bind:after="OnPageSizeChanged">
        <option value="10">10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="100">100</option>
    </select>
    <button class="btn btn-sm btn-success" @onclick="OpenAddModal">➕ Добавить</button>
</div>


<div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-1">
        <thead class="table-light">
            <tr>
                <th style="width: 60px">ID</th>
                <th @onclick="() => SortBy(nameof(Material.Name))" style="cursor: pointer;">
                    Наименование
                    @if (sortColumn == nameof(Material.Name))
                    {
                        <span class="ms-1">@(sortAscending ? "▲" : "▼")</span>
                    }
                </th>
                <th @onclick="() => SortBy(nameof(Material.Cost))" style="cursor: pointer; width: 130px" class="text-end">
                    Стоимость
                    @if (sortColumn == nameof(Material.Cost))
                    {
                        <span class="ms-1">@(sortAscending ? "▲" : "▼")</span>
                    }
                </th>
                <th style="width: 90px" class="text-center">Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (isLoading)
            {
                <tr><td colspan="4" class="text-center py-2">Загрузка...</td></tr>
            }
            else if (!items.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-2">Нет данных</td></tr>
            }
            else
            {
                @foreach (var m in items)
                {
                    <tr>
                        <td>@m.MaterialId</td>
                        <td>@m.Name</td>
                        <td class="text-end">@m.Cost.ToString("C")</td>
                        <td class="text-center text-nowrap">
                            <button class="btn btn-sm btn-link text-primary p-0 me-2" @onclick="() => OpenEditModal(m)" title="Редактировать">✏️</button>
                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => OpenDeleteConfirmation(m)" title="Удалить">🗑️</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="d-flex flex-nowrap justify-content-between align-items-center mt-1 gap-2">
    <div class="small text-muted">Всего: @totalCount</div>
    <div style="overflow-x: auto; white-space: nowrap; flex-grow: 1;">
        <ul class="pagination pagination-sm mb-0" style="display: flex; flex-wrap: nowrap; width: max-content;">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" @onclick="() => ChangePage(currentPage - 1)">◀</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" @onclick="() => ChangePage(i)">@i</a>
                    </li>
                }
                else if (i == currentPage - 3 || i == currentPage + 3)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" @onclick="() => ChangePage(currentPage + 1)">▶</a>
            </li>
        </ul>
    </div>
    <div class="d-flex gap-1">        
        <button class="btn btn-sm btn-outline-secondary" @onclick="GoToPage">OK</button>
    </div>
</div>

<!-- Модальное окно редактирования/добавления -->
<div class="modal @(showModal ? "show d-block" : "")" style="display: @(showModal ? "block" : "none"); background: rgba(0,0,0,0.5);" tabindex="-1"
     @onkeydown="HandleModalKeyDown" @onclick="HandleBackdropClick">
    <div class="modal-dialog modal-dialog-centered modal-sm" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header py-1">
                <h6 class="modal-title">@modalTitle</h6>               
            </div>
            <div class="modal-body py-2">
                <EditForm Model="@editItem" OnValidSubmit="@SaveItem">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger py-1 small" />
                    <div class="mb-2">
                        <label class="form-label small">Наименование</label>
                        <InputText @bind-Value="editItem.Name" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Стоимость</label>
                        <InputNumber @bind-Value="editItem.Cost" class="form-control form-control-sm" step="0.01" />
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <button type="submit" class="btn btn-sm btn-primary" disabled="@isSaving">
                            @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Сохранить
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseModal">Отмена</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно подтверждения удаления -->
<div class="modal @(showDeleteModal ? "show d-block" : "")" style="display: @(showDeleteModal ? "block" : "none"); background: rgba(0,0,0,0.5);" tabindex="-1"
     @onclick="CloseDeleteModalOnBackdrop" @onkeydown="HandleDeleteModalKeyDown">
    <div class="modal-dialog modal-dialog-centered modal-sm" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header py-1">
                <h6 class="modal-title">Удаление</h6>               
            </div>
            <div class="modal-body py-2 small">
                Удалить «<strong>@itemToDelete?.Name</strong>»?
            </div>
            <div class="modal-footer py-1">
                <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                    @if (isDeleting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Удалить
                </button>
                <button class="btn btn-sm btn-secondary" @onclick="CloseDeleteModal">Отмена</button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Material> items = new();
    private string searchName = "";
    private decimal? minCost = null;
    private decimal? maxCost = null;
    private string sortColumn = nameof(Material.Name);
    private bool sortAscending = true;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private int totalCount = 0;
    private int gotoPage = 1;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool isDeleting = false;
    private string notificationMessage = "";
    private string notificationType = "success";
    private bool showModal = false;
    private string modalTitle = "";
    private Material editItem = new();
    private bool showDeleteModal = false;
    private Material? itemToDelete = null;
    private Timer? searchDebounceTimer;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            var query = DbContext.Materials.AsQueryable();

            if (!string.IsNullOrWhiteSpace(searchName))
                query = query.Where(m => m.Name.Contains(searchName));
            if (minCost.HasValue)
                query = query.Where(m => m.Cost >= minCost.Value);
            if (maxCost.HasValue)
                query = query.Where(m => m.Cost <= maxCost.Value);

            totalCount = await query.CountAsync();

            query = sortAscending
                ? query.OrderBy(m => EF.Property<object>(m, sortColumn))
                : query.OrderByDescending(m => EF.Property<object>(m, sortColumn));

            totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
            if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            items = await query
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();
            gotoPage = currentPage;
        }
        catch (Exception ex)
        {
            ShowNotification($"Ошибка: {ex.Message}", "danger");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadData();
    }

    private async Task GoToPage()
    {
        if (gotoPage >= 1 && gotoPage <= totalPages)
            await ChangePage(gotoPage);
        else
            ShowNotification("Некорректный номер страницы", "danger");
    }

    private async Task SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        await LoadData();
    }

    private async Task OnPageSizeChanged()
    {
        currentPage = 1;
        await LoadData();
    }

    private void SetSearchName(string value)
    {
        searchName = value;
        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                currentPage = 1;
                await LoadData();
                StateHasChanged();
            });
        }, null, 300, Timeout.Infinite);
    }

    private async Task ClearSearch()
    {
        searchName = "";
        currentPage = 1;
        await LoadData();
    }

    private void OpenAddModal()
    {
        editItem = new Material();
        modalTitle = "Новый материал";
        showModal = true;
        StateHasChanged();
    }

    private void OpenEditModal(Material m)
    {
        editItem = new Material
        {
            MaterialId = m.MaterialId,
            Name = m.Name,
            Cost = m.Cost
        };
        modalTitle = "Редактирование";
        showModal = true;
        StateHasChanged();
    }

    private async Task SaveItem()
    {
        try
        {
            isSaving = true;
            if (editItem.MaterialId == 0)
            {
                DbContext.Materials.Add(editItem);
            }
            else
            {
                var existing = await DbContext.Materials.FindAsync(editItem.MaterialId);
                if (existing != null)
                {
                    existing.Name = editItem.Name;
                    existing.Cost = editItem.Cost;
                }
                else
                {
                    DbContext.Materials.Update(editItem);
                }
            }
            await DbContext.SaveChangesAsync();
            ShowNotification("Сохранено", "success");
            CloseModal();
            await LoadData();
        }
        catch (Exception ex)
        {
            ShowNotification($"Ошибка: {ex.InnerException?.Message ?? ex.Message}", "danger");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenDeleteConfirmation(Material m)
    {
        itemToDelete = m;
        showDeleteModal = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (itemToDelete == null) return;
        try
        {
            isDeleting = true;
            var entity = await DbContext.Materials.FindAsync(itemToDelete.MaterialId);
            if (entity != null)
            {
                DbContext.Materials.Remove(entity);
                await DbContext.SaveChangesAsync();
                ShowNotification($"Удалён: {itemToDelete.Name}", "success");
                CloseDeleteModal();
                await LoadData();
            }
            else
            {
                ShowNotification("Запись не найдена", "danger");
                CloseDeleteModal();
            }
        }
        catch (Exception ex)
        {
            ShowNotification($"Ошибка удаления: {ex.Message}", "danger");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void CloseModal()
    {
        showModal = false;
        editItem = new Material();
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        itemToDelete = null;
        StateHasChanged();
    }

    private void CloseDeleteModalOnBackdrop() => CloseDeleteModal();

    private void HandleModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseModal();
    }

    private void HandleDeleteModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseDeleteModal();
    }

    private void HandleBackdropClick() => CloseModal();

    private void ShowNotification(string message, string type)
    {
        notificationMessage = message;
        notificationType = type;
        StateHasChanged();
        Task.Delay(3000).ContinueWith(_ => InvokeAsync(ClearNotification));
    }

    private void ClearNotification()
    {
        notificationMessage = "";
        StateHasChanged();
    }

    public void Dispose() => searchDebounceTimer?.Dispose();
}