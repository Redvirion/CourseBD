@page "/materials"
@using CourseBD.Models
@using CourseBD.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<h3>Справочник материалов</h3>

<div class="row mb-3">
    <div class="col-md-3">
        <input @bind="searchName" @bind:event="oninput" class="form-control" placeholder="Поиск по наименованию" />
    </div>
    <div class="col-md-2">
        <input @bind="minPrice" @bind:event="oninput" class="form-control" placeholder="Мин. цена" type="number" step="0.01" />
    </div>
    <div class="col-md-2">
        <select @bind="sortField" class="form-select">
            <option value="Name">Наименование</option>
            <option value="Price">Цена</option>
        </select>
    </div>
    <div class="col-md-2">
        <select @bind="sortDirection" class="form-select">
            <option value="asc">По возрастанию</option>
            <option value="desc">По убыванию</option>
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary" @onclick="ApplyFilters">Применить</button>
        <button class="btn btn-secondary" @onclick="ResetFilters">Сброс</button>
    </div>
</div>

<div class="mb-2">
    <button class="btn btn-success" @onclick="OpenAddModal">Добавить материал</button>
</div>

@if (materials == null)
{
    <p>Загрузка...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Код</th>
                <th>Наименование</th>
                <th>Цена</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var material in materials)
            {
                <tr>
                    <td>@material.MaterialId</td>
                    <td>@material.Name</td>
                    <td>@material.Price.ToString("C")</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => OpenEditModal(material)">Изменить</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteMaterial(material.MaterialId)">Удалить</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Пагинация -->
    <nav>
        <ul class="pagination">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" @onclick="() => ChangePage(currentPage - 1)">Предыдущая</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link" @onclick="() => ChangePage(i)">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" @onclick="() => ChangePage(currentPage + 1)">Следующая</a>
            </li>
        </ul>
    </nav>
}

<!-- Модальное окно для добавления/редактирования -->
<div class="modal fade @(showModal ? "show d-block" : "")" style="background: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@modalTitle</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@editModel" OnValidSubmit="@SaveMaterial">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label class="form-label">Наименование</label>
                        <InputText @bind-Value="editModel.Name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Цена</label>
                        <InputNumber @bind-Value="editModel.Price" class="form-control" step="0.01" />
                    </div>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Material> materials;
    private string searchName = "";
    private decimal? minPrice;
    private string sortField = "Name";
    private string sortDirection = "asc";
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;

    private bool showModal = false;
    private string modalTitle = "Добавление материала";
    private Material editModel = new Material();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var query = DbContext.Materials.AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchName))
            query = query.Where(m => m.Name.Contains(searchName));
        if (minPrice.HasValue)
            query = query.Where(m => m.Price >= minPrice.Value);

        query = sortField switch
        {
            "Name" => sortDirection == "asc" ? query.OrderBy(m => m.Name) : query.OrderByDescending(m => m.Name),
            "Price" => sortDirection == "asc" ? query.OrderBy(m => m.Price) : query.OrderByDescending(m => m.Price),
            _ => query.OrderBy(m => m.MaterialId)
        };

        int totalCount = await query.CountAsync();
        totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);

        materials = await query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadData();
    }

    private async Task ResetFilters()
    {
        searchName = "";
        minPrice = null;
        sortField = "Name";
        sortDirection = "asc";
        currentPage = 1;
        await LoadData();
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadData();
    }

    private void OpenAddModal()
    {
        editModel = new Material();
        modalTitle = "Добавление материала";
        showModal = true;
    }

    private void OpenEditModal(Material material)
    {
        editModel = new Material
        {
            MaterialId = material.MaterialId,
            Name = material.Name,
            Price = material.Price
        };
        modalTitle = "Редактирование материала";
        showModal = true;
    }

    private async Task SaveMaterial()
    {
        if (editModel.MaterialId == 0)
            DbContext.Materials.Add(editModel);
        else
        {
            var existing = await DbContext.Materials.FindAsync(editModel.MaterialId);
            if (existing != null)
            {
                existing.Name = editModel.Name;
                existing.Price = editModel.Price;
            }
        }
        await DbContext.SaveChangesAsync();
        CloseModal();
        await LoadData();
    }

    private async Task DeleteMaterial(int id)
    {
        var material = await DbContext.Materials.FindAsync(id);
        if (material != null)
        {
            DbContext.Materials.Remove(material);
            await DbContext.SaveChangesAsync();
            await LoadData();
        }
    }

    private void CloseModal() => showModal = false;
}