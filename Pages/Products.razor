@page "/products"
@using CourseBD.Models
@using CourseBD.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<h3>Справочник изделий</h3>

<div class="row mb-3">
    <div class="col-md-3">
        <input @bind="searchName" @bind:event="oninput" class="form-control" placeholder="Наименование" />
    </div>
    <div class="col-md-2">
        <input @bind="minLabor" @bind:event="oninput" class="form-control" placeholder="Мин. трудоёмкость" type="number" step="0.01" />
    </div>
    <div class="col-md-2">
        <select @bind="sortField" class="form-select">
            <option value="Name">Наименование</option>
            <option value="LaborHours">Трудоёмкость</option>
        </select>
    </div>
    <div class="col-md-2">
        <select @bind="sortDirection" class="form-select">
            <option value="asc">По возрастанию</option>
            <option value="desc">По убыванию</option>
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary" @onclick="ApplyFilters">Применить</button>
        <button class="btn btn-secondary" @onclick="ResetFilters">Сброс</button>
    </div>
</div>

<div class="mb-2">
    <button class="btn btn-success" @onclick="OpenAddModal">Добавить изделие</button>
</div>

@if (products == null)
{
    <p>Загрузка...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Код</th>
                <th>Наименование</th>
                <th>Трудоёмкость</th>
                <th>Состав (денормализовано)</th>
                <th>Материал</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in products)
            {
                <tr>
                    <td>@prod.ProductId</td>
                    <td>@prod.Name</td>
                    <td>@prod.LaborHours</td>
                    <td>@prod.Composition</td>
                    <td>@prod.Material?.Name</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => OpenEditModal(prod)">Изменить</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteProduct(prod.ProductId)">Удалить</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Пагинация -->
    <nav>
        <ul class="pagination">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" @onclick="() => ChangePage(currentPage - 1)">Предыдущая</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link" @onclick="() => ChangePage(i)">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" @onclick="() => ChangePage(currentPage + 1)">Следующая</a>
            </li>
        </ul>
    </nav>
}

<!-- Модальное окно -->
<div class="modal fade @(showModal ? "show d-block" : "")" style="background: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@modalTitle</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@editModel" OnValidSubmit="@SaveProduct">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label class="form-label">Наименование</label>
                        <InputText @bind-Value="editModel.Name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Трудоёмкость (часы)</label>
                        <InputNumber @bind-Value="editModel.LaborHours" class="form-control" step="0.01" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Основной материал</label>
                        <InputSelect @bind-Value="editModel.MaterialRef" class="form-select">
                            <option value="">-- Не указан --</option>
                            @if (materials != null)
                            {
                                @foreach (var mat in materials)
                                {
                                    <option value="@mat.MaterialId">@mat.Name</option>
                                }
                            }
                            else
                            {
                                <option value="" disabled>Загрузка...</option>
                            }
                        </InputSelect>
                    </div>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Product> products = new();
    private List<Material> materials = new(); // Инициализация пустым списком
    private string searchName = "";
    private decimal? minLabor;
    private string sortField = "Name";
    private string sortDirection = "asc";
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;

    private bool showModal = false;
    private string modalTitle = "Добавление изделия";
    private Product editModel = new Product();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            materials = await DbContext.Materials.ToListAsync() ?? new List<Material>();
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка инициализации: {ex.Message}");
            materials = new List<Material>();
        }
    }

    private async Task LoadData()
    {
        var query = DbContext.Products
            .Include(p => p.Material)
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchName))
            query = query.Where(p => p.Name.Contains(searchName));
        if (minLabor.HasValue)
            query = query.Where(p => p.LaborHours >= minLabor.Value);

        query = sortField switch
        {
            "Name" => sortDirection == "asc" ? query.OrderBy(p => p.Name) : query.OrderByDescending(p => p.Name),
            "LaborHours" => sortDirection == "asc" ? query.OrderBy(p => p.LaborHours) : query.OrderByDescending(p => p.LaborHours),
            _ => query.OrderBy(p => p.ProductId)
        };

        int totalCount = await query.CountAsync();
        totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);

        products = await query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadData();
    }

    private async Task ResetFilters()
    {
        searchName = "";
        minLabor = null;
        sortField = "Name";
        sortDirection = "asc";
        currentPage = 1;
        await LoadData();
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadData();
    }

    private void OpenAddModal()
    {
        editModel = new Product();
        modalTitle = "Добавление изделия";
        showModal = true;
    }

    private void OpenEditModal(Product product)
    {
        editModel = new Product
        {
            ProductId = product.ProductId,
            Name = product.Name,
            LaborHours = product.LaborHours,
            MaterialRef = product.MaterialRef
        };
        modalTitle = "Редактирование изделия";
        showModal = true;
    }

    private async Task SaveProduct()
    {
        if (editModel.ProductId == 0)
            DbContext.Products.Add(editModel);
        else
        {
            var existing = await DbContext.Products.FindAsync(editModel.ProductId);
            if (existing != null)
            {
                existing.Name = editModel.Name;
                existing.LaborHours = editModel.LaborHours;
                existing.MaterialRef = editModel.MaterialRef;
            }
        }
        await DbContext.SaveChangesAsync();
        CloseModal();
        await LoadData();
    }

    private async Task DeleteProduct(int id)
    {
        var product = await DbContext.Products.FindAsync(id);
        if (product != null)
        {
            DbContext.Products.Remove(product);
            await DbContext.SaveChangesAsync();
            await LoadData();
        }
    }

    private void CloseModal() => showModal = false;

}