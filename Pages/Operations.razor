@page "/operations"
@using CourseBD.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@implements IDisposable

<h5 class="mb-2">⚙️ Операции</h5>

@if (!string.IsNullOrEmpty(notificationMessage))
{
    <div class="alert alert-@notificationType alert-dismissible fade show d-flex align-items-center py-1 mb-2" role="alert">
        <span class="flex-grow-1 small">@notificationMessage</span>
        <button type="button" class="btn-close btn-close-sm" @onclick="ClearNotification"></button>
    </div>
}

<div class="d-flex flex-nowrap gap-2 mb-2 align-items-end overflow-auto">
    <div class="input-group input-group-sm" style="min-width: 200px;">
        <span class="input-group-text">🔍</span>
        <input type="text" class="form-control form-control-sm"
               @bind-value:get="searchName"
               @bind-value:set="SetSearchName"
               @bind-value:event="oninput"
               placeholder="Наименование" />
        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSearch">✖</button>
    </div>
    <select class="form-select form-select-sm" style="width: auto;" @bind="pageSize" @bind:after="OnPageSizeChanged">
        <option value="10">10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="100">100</option>
    </select>
    <button class="btn btn-sm btn-success" @onclick="OpenAddModal">➕ Добавить</button>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-1">
        <thead class="table-light">
            <tr>
                <th style="width: 60px">ID</th>
                <th @onclick="() => SortBy(nameof(Operation.Name))" style="cursor: pointer;">
                    Наименование
                    @if (sortColumn == nameof(Operation.Name))
                    {
                        <span class="ms-1">@(sortAscending ? "▲" : "▼")</span>
                    }
                </th>
                <th @onclick="() => SortBy(nameof(Operation.Cost))" style="cursor: pointer; width: 130px" class="text-end">
                    Стоимость
                    @if (sortColumn == nameof(Operation.Cost))
                    {
                        <span class="ms-1">@(sortAscending ? "▲" : "▼")</span>
                    }
                </th>
                <th style="width: 90px" class="text-center">Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (isLoading)
            {
                <tr><td colspan="4" class="text-center py-2">Загрузка...</td></tr>
            }
            else if (!items.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-2">Нет данных</td></tr>
            }
            else
            {
                @foreach (var op in items)
                {
                    <tr>
                        <td>@op.OperationId</td>
                        <td>@op.Name</td>
                        <td class="text-end">@op.Cost.ToString("C")</td>
                        <td class="text-center text-nowrap">
                            <button class="btn btn-sm btn-link text-primary p-0 me-2" @onclick="() => OpenEditModal(op)" title="Редактировать">✏️</button>
                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => OpenDeleteConfirmation(op)" title="Удалить">🗑️</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Пагинация -->
<div class="d-flex flex-nowrap justify-content-between align-items-center mt-1 gap-2">
    <div class="small text-muted">Всего: @totalCount</div>
    <div style="overflow-x: auto; white-space: nowrap; flex-grow: 1;">
        <ul class="pagination pagination-sm mb-0" style="display: flex; flex-wrap: nowrap; width: max-content;">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" @onclick="() => ChangePage(currentPage - 1)">◀</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" @onclick="() => ChangePage(i)">@i</a>
                    </li>
                }
                else if (i == currentPage - 3 || i == currentPage + 3)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" @onclick="() => ChangePage(currentPage + 1)">▶</a>
            </li>
        </ul>
    </div>
    <div class="d-flex gap-1">
        <input type="number" class="form-control form-control-sm" style="width: 60px" min="1" max="@totalPages" @bind="gotoPage" @bind:event="oninput" />
        <button class="btn btn-sm btn-outline-secondary" @onclick="GoToPage">OK</button>
    </div>
</div>

<!-- Модальное окно -->
<div class="modal @(showModal ? "show d-block" : "")" style="display: @(showModal ? "block" : "none"); background: rgba(0,0,0,0.5);" tabindex="-1"
     @onkeydown="HandleModalKeyDown" @onclick="HandleBackdropClick">
    <div class="modal-dialog modal-dialog-centered modal-sm" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header py-1"><h6 class="modal-title">@modalTitle</h6></div>
            <div class="modal-body py-2">
                <EditForm Model="@editItem" OnValidSubmit="@SaveItem">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger py-1 small" />
                    <div class="mb-2">
                        <label class="form-label small">Наименование</label>
                        <InputText @bind-Value="editItem.Name" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Стоимость</label>
                        <InputNumber @bind-Value="editItem.Cost" class="form-control form-control-sm" step="0.01" />
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <button type="submit" class="btn btn-sm btn-primary" disabled="@isSaving">
                            @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Сохранить
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseModal">Отмена</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<!-- Подтверждение удаления -->
<div class="modal @(showDeleteModal ? "show d-block" : "")" style="display: @(showDeleteModal ? "block" : "none"); background: rgba(0,0,0,0.5);" tabindex="-1"
     @onclick="CloseDeleteModalOnBackdrop" @onkeydown="HandleDeleteModalKeyDown">
    <div class="modal-dialog modal-dialog-centered modal-sm" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header py-1"><h6 class="modal-title">Удаление</h6></div>
            <div class="modal-body py-2 small">Удалить операцию «<strong>@itemToDelete?.Name</strong>»?</div>
            <div class="modal-footer py-1">
                <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                    @if (isDeleting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Удалить
                </button>
                <button class="btn btn-sm btn-secondary" @onclick="CloseDeleteModal">Отмена</button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Operation> items = new();
    private string searchName = "";
    private string sortColumn = nameof(Operation.Name);
    private bool sortAscending = true;
    private int currentPage = 1, pageSize = 10, totalPages = 1, totalCount = 0, gotoPage = 1;
    private bool isLoading, isSaving, isDeleting, showModal, showDeleteModal;
    private string notificationMessage = "", notificationType = "success", modalTitle = "";
    private Operation editItem = new();
    private Operation? itemToDelete = null;
    private Timer? searchDebounceTimer;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            var query = DbContext.Operations.AsQueryable();
            if (!string.IsNullOrWhiteSpace(searchName))
                query = query.Where(o => o.Name.Contains(searchName));
            totalCount = await query.CountAsync();
            query = sortAscending ? query.OrderBy(o => EF.Property<object>(o, sortColumn)) : query.OrderByDescending(o => EF.Property<object>(o, sortColumn));
            totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
            if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;
            items = await query.Skip((currentPage - 1) * pageSize).Take(pageSize).ToListAsync();
            gotoPage = currentPage;
        }
        catch (Exception ex) { ShowNotification($"Ошибка: {ex.Message}", "danger"); }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task ChangePage(int page) { if (page < 1 || page > totalPages) return; currentPage = page; await LoadData(); }
    private async Task GoToPage() { if (gotoPage >= 1 && gotoPage <= totalPages) await ChangePage(gotoPage); else ShowNotification("Некорректный номер страницы", "danger"); }
    private async Task SortBy(string column) { if (sortColumn == column) sortAscending = !sortAscending; else { sortColumn = column; sortAscending = true; } currentPage = 1; await LoadData(); }
    private async Task OnPageSizeChanged() { currentPage = 1; await LoadData(); }
    private void SetSearchName(string value) { searchName = value; searchDebounceTimer?.Dispose(); searchDebounceTimer = new Timer(_ => InvokeAsync(async () => { currentPage = 1; await LoadData(); StateHasChanged(); }), null, 300, Timeout.Infinite); }
    private async Task ClearSearch() { searchName = ""; currentPage = 1; await LoadData(); }
    private void OpenAddModal() { editItem = new(); modalTitle = "Новая операция"; showModal = true; StateHasChanged(); }
    private void OpenEditModal(Operation o) { editItem = new Operation { OperationId = o.OperationId, Name = o.Name, Cost = o.Cost }; modalTitle = "Редактирование"; showModal = true; StateHasChanged(); }
    private async Task SaveItem()
    {
        try
        {
            isSaving = true;
            if (editItem.OperationId == 0) DbContext.Operations.Add(editItem);
            else { var existing = await DbContext.Operations.FindAsync(editItem.OperationId); if (existing != null) { existing.Name = editItem.Name; existing.Cost = editItem.Cost; } else DbContext.Operations.Update(editItem); }
            await DbContext.SaveChangesAsync();
            ShowNotification("Сохранено", "success");
            CloseModal();
            await LoadData();
        }
        catch (Exception ex) { ShowNotification($"Ошибка: {ex.InnerException?.Message ?? ex.Message}", "danger"); }
        finally { isSaving = false; }
    }
    private void OpenDeleteConfirmation(Operation o) { itemToDelete = o; showDeleteModal = true; StateHasChanged(); }
    private async Task ConfirmDelete()
    {
        if (itemToDelete == null) return;
        try
        {
            isDeleting = true;
            var entity = await DbContext.Operations.FindAsync(itemToDelete.OperationId);
            if (entity != null) { DbContext.Operations.Remove(entity); await DbContext.SaveChangesAsync(); ShowNotification($"Удалена операция «{itemToDelete.Name}»", "success"); CloseDeleteModal(); await LoadData(); }
            else { ShowNotification("Запись не найдена", "danger"); CloseDeleteModal(); }
        }
        catch (Exception ex) { ShowNotification($"Ошибка удаления: {ex.Message}", "danger"); }
        finally { isDeleting = false; }
    }
    private void CloseModal() { showModal = false; editItem = new(); StateHasChanged(); }
    private void CloseDeleteModal() { showDeleteModal = false; itemToDelete = null; StateHasChanged(); }
    private void CloseDeleteModalOnBackdrop() => CloseDeleteModal();
    private void HandleModalKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") CloseModal(); }
    private void HandleDeleteModalKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") CloseDeleteModal(); }
    private void HandleBackdropClick() => CloseModal();
    private void ShowNotification(string message, string type) { notificationMessage = message; notificationType = type; StateHasChanged(); Task.Delay(3000).ContinueWith(_ => InvokeAsync(ClearNotification)); }
    private void ClearNotification() { notificationMessage = ""; StateHasChanged(); }
    public void Dispose() => searchDebounceTimer?.Dispose();
}