@page "/productcomposition"
@using CourseBD.Models
@using CourseBD.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<h3>Редактирование состава изделия</h3>

<div class="row">
    <div class="col-md-4">
        <label>Выберите изделие:</label>
        <select @bind="selectedProductId" @bind:after="LoadComposition" class="form-select">
            <option value="">-- Выберите изделие --</option>
            @if (products != null)
            {
                @foreach (var product in products)
                {
                    <option value="@product.ProductId">@product.Name</option>
                }
            }
            else
            {
                <option value="" disabled>Загрузка...</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary mt-4" @onclick="OpenNewProductModal">Новое изделие</button>
    </div>
</div>

@if (selectedProductId != 0)
{
    <h4 class="mt-3">Состав изделия: @selectedProductName</h4>

    <div class="mb-3">
        <button class="btn btn-success" @onclick="OpenAddComponentModal">Добавить комплектующее</button>
    </div>

    @if (composition == null || composition.Count == 0)
    {
        <p>Состав пуст.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Комплектующее</th>
                    <th>Количество</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in composition)
                {
                    <tr>
                        <td>@item.Component?.Name</td>
                        <td>@item.Quantity</td>
                        <td>
                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveComponent(item.ComponentId)">Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<!-- Модальное окно добавления комплектующего -->
<div class="modal fade @(showAddModal ? "show d-block" : "")" style="background: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Добавление комплектующего</h5>
                <button type="button" class="btn-close" @onclick="CloseAddModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@newComposition" OnValidSubmit="@AddComponent">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label class="form-label">Комплектующее</label>
                        <InputSelect @bind-Value="newComposition.ComponentId" class="form-select">
                            <option value="">-- Выберите --</option>
                            @foreach (var comp in availableComponents)
                            {
                                <option value="@comp.ComponentId">@comp.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Количество</label>
                        <InputNumber @bind-Value="newComposition.Quantity" class="form-control" min="1" />
                    </div>
                    <button type="submit" class="btn btn-primary">Добавить</button>
                    <button type="button" class="btn btn-secondary" @onclick="CloseAddModal">Отмена</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно создания нового изделия -->
<div class="modal fade @(showNewProductModal ? "show d-block" : "")" style="background: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Новое изделие</h5>
                <button type="button" class="btn-close" @onclick="CloseNewProductModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@newProduct" OnValidSubmit="@CreateProduct">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label class="form-label">Наименование</label>
                        <InputText @bind-Value="newProduct.Name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Трудоёмкость (часы)</label>
                        <InputNumber @bind-Value="newProduct.LaborHours" class="form-control" step="0.01" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Основной материал (необязательно)</label>
                        <InputSelect @bind-Value="newProduct.MaterialRef" class="form-select">
                            <option value="">-- Не указан --</option>
                            @if (materials != null)
                            {
                                @foreach (var mat in materials)
                                {
                                    <option value="@mat.MaterialId">@mat.Name</option>
                                }
                            }
                            else
                            {
                                <option value="" disabled>Загрузка...</option>
                            }
                        </InputSelect>
                    </div>
                    <button type="submit" class="btn btn-primary">Создать</button>
                    <button type="button" class="btn btn-secondary" @onclick="CloseNewProductModal">Отмена</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Product> products = new();
    private List<Material> materials = new(); // инициализируем пустым списком
    private int selectedProductId;
    private string selectedProductName;
    private List<ProductComposition> composition = new();
    private List<Component> availableComponents = new();

    private bool showAddModal = false;
    private ProductComposition newComposition = new ProductComposition();

    private bool showNewProductModal = false;
    private Product newProduct = new Product();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadProducts();
            materials = await DbContext.Materials.ToListAsync() ?? new List<Material>();
            availableComponents = await DbContext.Components.ToListAsync() ?? new List<Component>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки данных: {ex.Message}");
        }
    }

    private async Task LoadProducts()
    {
        try
        {
            products = await DbContext.Products.ToListAsync() ?? new List<Product>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки изделий: {ex.Message}");
            products = new List<Product>();
        }
    }

    private async Task LoadComposition()
    {
        if (selectedProductId == 0) return;
        selectedProductName = products.First(p => p.ProductId == selectedProductId).Name;
        composition = await DbContext.ProductCompositions
            .Include(pc => pc.Component)
            .Where(pc => pc.ProductId == selectedProductId)
            .ToListAsync();
    }

    private void OpenNewProductModal()
    {
        newProduct = new Product();
        showNewProductModal = true;
    }

    private async Task CreateProduct()
    {
        DbContext.Products.Add(newProduct);
        await DbContext.SaveChangesAsync();
        await LoadProducts();
        selectedProductId = newProduct.ProductId;
        await LoadComposition();
        CloseNewProductModal();
    }

    private void OpenAddComponentModal()
    {
        if (selectedProductId == 0) return;
        newComposition = new ProductComposition { ProductId = selectedProductId, Quantity = 1 };
        showAddModal = true;
    }

    private async Task AddComponent()
    {
        var exists = await DbContext.ProductCompositions
            .AnyAsync(pc => pc.ProductId == selectedProductId && pc.ComponentId == newComposition.ComponentId);
        if (exists)
        {
            // Можно добавить уведомление
            return;
        }

        DbContext.ProductCompositions.Add(newComposition);
        await DbContext.SaveChangesAsync();
        await LoadComposition();
        CloseAddModal();
    }

    private async Task RemoveComponent(string componentId)
    {
        var item = await DbContext.ProductCompositions
            .FirstOrDefaultAsync(pc => pc.ProductId == selectedProductId && pc.ComponentId == componentId);
        if (item != null)
        {
            DbContext.ProductCompositions.Remove(item);
            await DbContext.SaveChangesAsync();
            await LoadComposition();
        }
    }

    private void CloseAddModal() => showAddModal = false;
    private void CloseNewProductModal() => showNewProductModal = false;

}