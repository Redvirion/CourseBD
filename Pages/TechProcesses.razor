@page "/techprocesses"
@using CourseBD.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@implements IDisposable

<h5 class="mb-2">⚙️ Техпроцессы</h5>

@if (!string.IsNullOrEmpty(notificationMessage))
{
    <div class="alert alert-@notificationType alert-dismissible fade show d-flex align-items-center py-1 mb-2" role="alert">
        <span class="flex-grow-1 small">@notificationMessage</span>
        <button type="button" class="btn-close btn-close-sm" @onclick="ClearNotification"></button>
    </div>
}

<div class="d-flex flex-nowrap gap-2 mb-2 align-items-end overflow-auto">
    <select class="form-select form-select-sm" style="width: 200px;" @bind="filterMaterialId">
        <option value="0">Все материалы</option>
        @foreach (var m in materials) { <option value="@m.MaterialId">@m.Name</option> }
    </select>
    <select class="form-select form-select-sm" style="width: auto;" @bind="pageSize" @bind:after="OnPageSizeChanged">
        <option value="10">10</option><option value="25">25</option><option value="50">50</option><option value="100">100</option>
    </select>
    <button class="btn btn-sm btn-success" @onclick="OpenAddModal">➕ Добавить</button>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-1">
        <thead class="table-light">
            <tr><th style="width: 60px">ID</th><th>Материал</th><th style="width: 100px">Кол-во</th><th>Операции</th><th style="width: 100px" class="text-center">Действия</th></tr>
        </thead>
        <tbody>
            @if (isLoading)
            {
                <tr><td colspan="5" class="text-center py-2">Загрузка...</td></tr>
            }
            else if (!items.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-2">Нет данных</td></tr>
            }
            else
            {
                @foreach (var tp in items)
                {
                    <tr>
                        <td>@tp.TechProcessId</td>
                        <td>@tp.Material?.Name</td>
                        <td>@tp.MaterialQuantity</td>
                        <td>@tp.OperationsList</td>
                        <td class="text-center text-nowrap">
                            <button class="btn btn-sm btn-link text-primary p-0 me-2" @onclick="() => OpenEditModal(tp)" title="Редактировать">✏️</button>
                            <button class="btn btn-sm btn-link text-info p-0 me-2" @onclick="() => OpenOperationsModal(tp)" title="Операции">⚙️</button>
                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => OpenDeleteConfirmation(tp)" title="Удалить">🗑️</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Пагинация -->
<div class="d-flex flex-nowrap justify-content-between align-items-center mt-1 gap-2">
    <div class="small text-muted">Всего: @totalCount</div>
    <div style="overflow-x: auto; white-space: nowrap; flex-grow: 1;">
        <ul class="pagination pagination-sm mb-0" style="display: flex; flex-wrap: nowrap; width: max-content;">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")"><a class="page-link" @onclick="() => ChangePage(currentPage - 1)">◀</a></li>
            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                {
                    <li class="page-item @(currentPage == i ? "active" : "")"><a class="page-link" @onclick="() => ChangePage(i)">@i</a></li>
                }
                else if (i == currentPage - 3 || i == currentPage + 3)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")"><a class="page-link" @onclick="() => ChangePage(currentPage + 1)">▶</a></li>
        </ul>
    </div>
    <div class="d-flex gap-1">
        <input type="number" class="form-control form-control-sm" style="width: 60px" min="1" max="@totalPages" @bind="gotoPage" @bind:event="oninput" />
        <button class="btn btn-sm btn-outline-secondary" @onclick="GoToPage">OK</button>
    </div>
</div>

<!-- Модальное окно для редактирования техпроцесса -->
<div class="modal @(showModal ? "show d-block" : "")" style="display: @(showModal ? "block" : "none"); background: rgba(0,0,0,0.5);" tabindex="-1" @onkeydown="HandleModalKeyDown" @onclick="HandleBackdropClick">
    <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header py-1"><h6 class="modal-title">@modalTitle</h6></div>
            <div class="modal-body py-2">
                <EditForm Model="@editItem" OnValidSubmit="@SaveItem">
                    <DataAnnotationsValidator /><ValidationSummary class="alert alert-danger py-1 small" />
                    <div class="mb-2">
                        <label class="form-label small">Материал</label>
                        <InputSelect @bind-Value="editItem.MaterialId" class="form-select form-select-sm">
                            <option value="0">-- Выберите --</option>
                            @foreach (var m in materials) { <option value="@m.MaterialId">@m.Name</option> }
                        </InputSelect>
                    </div>
                    <div class="mb-2"><label class="form-label small">Количество материала</label><InputNumber @bind-Value="editItem.MaterialQuantity" class="form-control form-control-sm" step="0.01" /></div>
                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <button type="submit" class="btn btn-sm btn-primary" disabled="@isSaving">@if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> } Сохранить</button>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseModal">Отмена</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно для управления операциями (техпроцесс-операции) -->
<div class="modal @(showOperationsModal ? "show d-block" : "")" style="display: @(showOperationsModal ? "block" : "none"); background: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header py-1"><h6 class="modal-title">Операции техпроцесса</h6>             
                </div>
            <div class="modal-body py-2">
                <div class="d-flex gap-2 mb-2">
                    <select @bind="selectedOperationId" class="form-select form-select-sm">
                        <option value="0">-- Добавить операцию --</option>
                        @foreach (var op in allOperations) { <option value="@op.OperationId">@op.Name (@op.Cost.ToString("C"))</option> }
                    </select>
                    <button class="btn btn-sm btn-primary" @onclick="AddOperation">Добавить</button>
                    <button class="btn btn-sm btn-close-sm" @onclick="CloseOperationsModal">Отмена</button>
                </div>
                <ul class="list-group">
                    @foreach (var op in currentTechProcessOperations)
                    {
                        <li class="list-group-item py-1 d-flex justify-content-between align-items-center">
                            @op.Name (@op.Cost.ToString("C"))
                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => RemoveOperation(op.OperationId)">🗑️</button>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Подтверждение удаления -->
<div class="modal @(showDeleteModal ? "show d-block" : "")" style="display: @(showDeleteModal ? "block" : "none"); background: rgba(0,0,0,0.5);" tabindex="-1" @onclick="CloseDeleteModalOnBackdrop" @onkeydown="HandleDeleteModalKeyDown">
    <div class="modal-dialog modal-dialog-centered modal-sm" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header py-1"><h6 class="modal-title">Удаление</h6></div>
            <div class="modal-body py-2 small">Удалить техпроцесс №<strong>@itemToDelete?.TechProcessId</strong>?</div>
            <div class="modal-footer py-1">
                <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">@if (isDeleting) { <span class="spinner-border spinner-border-sm me-1"></span> } Удалить</button>
                <button class="btn btn-sm btn-secondary" @onclick="CloseDeleteModal">Отмена</button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<TechProcess> items = new();
    private List<Material> materials = new();
    private List<Operation> allOperations = new();
    private int filterMaterialId = 0;
    private int currentPage = 1, pageSize = 10, totalPages = 1, totalCount = 0, gotoPage = 1;
    private bool isLoading, isSaving, isDeleting, showModal, showDeleteModal, showOperationsModal;
    private string notificationMessage = "", notificationType = "success", modalTitle = "";
    private TechProcess editItem = new();
    private TechProcess? itemToDelete = null;
    private List<Operation> currentTechProcessOperations = new();
    private int selectedOperationId = 0;
    private int currentTechProcessId = 0;

    protected override async Task OnInitializedAsync()
    {
        materials = await DbContext.Materials.ToListAsync();
        allOperations = await DbContext.Operations.ToListAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            var query = DbContext.TechProcesses.Include(t => t.Material).AsQueryable();
            if (filterMaterialId != 0) query = query.Where(t => t.MaterialId == filterMaterialId);
            totalCount = await query.CountAsync();
            query = query.OrderBy(t => t.TechProcessId);
            totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
            if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;
            items = await query.Skip((currentPage - 1) * pageSize).Take(pageSize).ToListAsync();
            gotoPage = currentPage;
        }
        catch (Exception ex) { ShowNotification($"Ошибка: {ex.Message}", "danger"); }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task ChangePage(int page) { if (page < 1 || page > totalPages) return; currentPage = page; await LoadData(); }
    private async Task GoToPage() { if (gotoPage >= 1 && gotoPage <= totalPages) await ChangePage(gotoPage); else ShowNotification("Некорректный номер страницы", "danger"); }
    private async Task OnPageSizeChanged() { currentPage = 1; await LoadData(); }
    private void OpenAddModal() { editItem = new(); modalTitle = "Новый техпроцесс"; showModal = true; StateHasChanged(); }
    private void OpenEditModal(TechProcess tp) { editItem = new TechProcess { TechProcessId = tp.TechProcessId, MaterialId = tp.MaterialId, MaterialQuantity = tp.MaterialQuantity }; modalTitle = "Редактирование"; showModal = true; StateHasChanged(); }
    private async Task SaveItem()
    {
        try
        {
            isSaving = true;
            if (editItem.TechProcessId == 0) DbContext.TechProcesses.Add(editItem);
            else { var existing = await DbContext.TechProcesses.FindAsync(editItem.TechProcessId); if (existing != null) { existing.MaterialId = editItem.MaterialId; existing.MaterialQuantity = editItem.MaterialQuantity; } else DbContext.TechProcesses.Update(editItem); }
            await DbContext.SaveChangesAsync();
            ShowNotification("Сохранено", "success");
            CloseModal();
            await LoadData();
        }
        catch (Exception ex) { ShowNotification($"Ошибка: {ex.InnerException?.Message ?? ex.Message}", "danger"); }
        finally { isSaving = false; }
    }
    private void OpenDeleteConfirmation(TechProcess tp) { itemToDelete = tp; showDeleteModal = true; StateHasChanged(); }
    private async Task ConfirmDelete()
    {
        if (itemToDelete == null) return;
        try
        {
            isDeleting = true;
            var entity = await DbContext.TechProcesses.FindAsync(itemToDelete.TechProcessId);
            if (entity != null) { DbContext.TechProcesses.Remove(entity); await DbContext.SaveChangesAsync(); ShowNotification($"Удалён техпроцесс №{itemToDelete.TechProcessId}", "success"); CloseDeleteModal(); await LoadData(); }
            else { ShowNotification("Запись не найдена", "danger"); CloseDeleteModal(); }
        }
        catch (Exception ex) { ShowNotification($"Ошибка удаления: {ex.Message}", "danger"); }
        finally { isDeleting = false; }
    }
    private async void OpenOperationsModal(TechProcess tp)
    {
        currentTechProcessId = tp.TechProcessId;
        var opIds = await DbContext.TechProcessOperations.Where(tpo => tpo.TechProcessId == tp.TechProcessId).Select(tpo => tpo.OperationId).ToListAsync();
        currentTechProcessOperations = await DbContext.Operations.Where(o => opIds.Contains(o.OperationId)).ToListAsync();
        showOperationsModal = true;
        StateHasChanged();
    }
    private async Task AddOperation()
    {
        if (selectedOperationId == 0 || currentTechProcessId == 0) return;
        var exists = await DbContext.TechProcessOperations.AnyAsync(tpo => tpo.TechProcessId == currentTechProcessId && tpo.OperationId == selectedOperationId);
        if (!exists)
        {
            DbContext.TechProcessOperations.Add(new TechProcessOperation { TechProcessId = currentTechProcessId, OperationId = selectedOperationId });
            await DbContext.SaveChangesAsync();
            OpenOperationsModal(await DbContext.TechProcesses.FindAsync(currentTechProcessId));
        }
    }
    private async Task RemoveOperation(int operationId)
    {
        var item = await DbContext.TechProcessOperations.FirstOrDefaultAsync(tpo => tpo.TechProcessId == currentTechProcessId && tpo.OperationId == operationId);
        if (item != null) { DbContext.TechProcessOperations.Remove(item); await DbContext.SaveChangesAsync(); OpenOperationsModal(await DbContext.TechProcesses.FindAsync(currentTechProcessId)); }
    }
    private void CloseModal() { showModal = false; editItem = new(); StateHasChanged(); }
    private void CloseDeleteModal() { showDeleteModal = false; itemToDelete = null; StateHasChanged(); }
    private void CloseDeleteModalOnBackdrop() => CloseDeleteModal();
    private void CloseOperationsModal() { showOperationsModal = false; currentTechProcessId = 0; currentTechProcessOperations.Clear(); selectedOperationId = 0; StateHasChanged(); }
    private void HandleModalKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") CloseModal(); }
    private void HandleDeleteModalKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") CloseDeleteModal(); }
    private void HandleBackdropClick() => CloseModal();
    private void ShowNotification(string message, string type) { notificationMessage = message; notificationType = type; StateHasChanged(); Task.Delay(3000).ContinueWith(_ => InvokeAsync(ClearNotification)); }
    private void ClearNotification() { notificationMessage = ""; StateHasChanged(); }
    public void Dispose() { }
}